{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FuckExam",
  "version": "0.1.0",
  "identifier": "dev.fuckexam.app",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "FuckExam",
        "width": 520,
        "height": 720,
        "minWidth": 420,
        "minHeight": 560,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}