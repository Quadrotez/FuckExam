{
  "name": "МЭШ: все задания",
  "description": "Собирает задания с открытой страницы МЭШ и показывает их в едином интерфейсе.",
  "version": "0.1.0",
  "manifest_version": 3,
  "action": {
    "default_title": "Собрать задания МЭШ"
  },
  "permissions": ["storage", "activeTab", "tabs"],
  "host_permissions": [
    "https://school.mos.ru/*",
    "https://dnevnik.mos.ru/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://school.mos.ru/*",
        "https://dnevnik.mos.ru/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "options_page": "options.html"
}
